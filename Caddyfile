{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), payment=(self), accelerometer=(self), gyroscope=(self), clipboard-write=(self), browsing-topics=()"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https: wss:; frame-src https://*.thirdweb.com https://*.walletconnect.com https://*.walletconnect.org https://keys.coinbase.com; worker-src 'self' blob:"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	@media path /images/* /models/* /music/* /Logo/*
	header @media Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@seo path /robots.txt /sitemap.xml /llms.txt
	header @seo Cache-Control "public, max-age=3600"

	# Client-only app routes (same list as vercel.json rewrites).
	# Hidden products (key-drive…) are admin-only previews: served as SPA routes so the admin guard decides.
	@spa path_regexp ^/(panel|feed|empresas|usuarios|checkout|pertenencias|demo-en-vivo|inquilino|perfil|configuracion|tokenizar|swap|admin|keypay|key-drive|key-jobs|key-rural|escrow-chain|tracker-gps)(/.*)?$|^/bookey/.+$
	rewrite @spa /__spa-fallback.html

	# Asset pages and academy articles created after the build (admin panel) are rendered client-side.
	@liveAsset {
		path_regexp ^/(tokenizaciones/[0-9]+|academia/[a-z0-9-]+)/?$
		not file {
			try_files {path}/index.html
		}
	}
	rewrite @liveAsset /__spa-fallback.html

	# Prerendered pages live at <path>/index.html (no trailing-slash redirects).
	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
