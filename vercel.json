{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:page(panel|feed|empresas|usuarios|checkout|pertenencias|demo-en-vivo|inquilino|perfil|configuracion|tokenizar|swap|admin|keypay)/:rest*",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/:page(panel|feed|empresas|usuarios|checkout|pertenencias|demo-en-vivo|inquilino|perfil|configuracion|tokenizar|swap|admin|keypay)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/:product(bookey|key-drive|key-jobs|key-rural|escrow-chain|tracker-gps)/:rest+",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/:product(key-drive|key-jobs|key-rural|escrow-chain|tracker-gps)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/tokenizaciones/:id(\\d+)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/academia/:slug([a-z0-9-]+)",
      "destination": "/__spa-fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=(), payment=(self), accelerometer=(self), gyroscope=(self), clipboard-write=(self), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https: wss:; frame-src https://*.thirdweb.com https://*.walletconnect.com https://*.walletconnect.org https://keys.coinbase.com; worker-src 'self' blob:" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:dir(images|models|music|Logo)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/:file(robots.txt|sitemap.xml|llms.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
