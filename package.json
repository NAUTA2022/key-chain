    "downshift": "^9.4.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "isbot": "^5.1.36",
    "leaflet": "^1.9.4",
    "ogl": "^1.0.11",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
